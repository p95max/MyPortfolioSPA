# Create a bot with @BotFather. The service cannot start without this value.
TELEGRAM_BOT_TOKEN=

# Add the key after Tankerkoenig approves the application. The bot can start
# without it and will show a friendly "data source pending" message.
TANKERKOENIG_API_KEY=

REDIS_URL=redis://redis:6379/1
LOG_LEVEL=INFO

# Chemnitz city centre and public-bot defaults.
CHEMNITZ_LAT=50.8278
CHEMNITZ_LNG=12.9214
DEFAULT_RADIUS_KM=8
DEFAULT_FUEL_TYPE=diesel
CACHE_TTL_SECONDS=300
UPSTREAM_INTERVAL_SECONDS=61
USER_RATE_LIMIT=10
USER_RATE_WINDOW_SECONDS=60
