# Django
DJANGO_SECRET_KEY=django-insecure-local-docker-dev-key
DJANGO_DEBUG=True
DJANGO_ADMIN_URL=admin/

# Database inside Docker network
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_password
DB_HOST=db
DB_PORT=5432

# Local admin user
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpass

# Hosts / CORS / CSRF
ALLOWED_HOST=localhost
EXTRA_ALLOWED_HOSTS=127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Local URLs
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# Cloudflare Turnstile test keys
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Email disabled/console for local dev
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
NOTIFY_EMAILS=
DISPLAY_TZ=Europe/Berlin

# Redis for closer-to-prod throttling behavior
REDIS_URL=redis://redis:6379/0
DRF_NUM_PROXIES=0
TRUST_ANALYTICS_GEO_HEADERS=False
ANALYTICS_GEOIP_LOOKUP_ENABLED=False

# Local bootstrap
LOAD_FIXTURES=True

# Optional analytics email alerts
ANALYTICS_NEW_VISITOR_EMAIL_ENABLED=False
ANALYTICS_NOTIFY_DIRECT_VISITORS=False
