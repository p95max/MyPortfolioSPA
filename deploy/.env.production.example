# Copy to /etc/portfolio/portfolio.env on the VPS. Never commit the real file.
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ADMIN_URL=admin/
ALLOWED_HOST=portfolio.example.com
EXTRA_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=https://portfolio.example.com
CORS_ALLOWED_ORIGINS=https://portfolio.example.com
TURNSTILE_SECRET=
FRONTEND_BASE_URL=https://portfolio.example.com
BACKEND_BASE_URL=https://portfolio.example.com
REDIS_URL=redis://redis:6379/0
DRF_NUM_PROXIES=1

EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
NOTIFY_EMAILS=
DISPLAY_TZ=Europe/Berlin

# Public build-time frontend variables.
VITE_API_URL=
VITE_USE_API_PROXY=true
VITE_TURNSTILE_SITEKEY=
VITE_SNOW=auto

# VPS resource profile (1 vCPU / 1 GB RAM).
MEMORY_LIMIT=512
REDIS_MAXMEMORY=64mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=30

# Host-side operations and Telegram bot. IDs are comma-separated numeric IDs.
PORTFOLIO_ENV_LABEL=PROD
PORTFOLIO_PUBLIC_URL=https://portfolio.example.com
PORTFOLIO_DEPLOY_BRANCH=prod
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_FREE_SPACE_MB=1024
