FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . ./

ARG VITE_API_URL=
ARG VITE_USE_API_PROXY=true
ARG VITE_TURNSTILE_SITEKEY=
ARG VITE_SNOW=auto

ENV VITE_API_URL=$VITE_API_URL \
    VITE_USE_API_PROXY=$VITE_USE_API_PROXY \
    VITE_TURNSTILE_SITEKEY=$VITE_TURNSTILE_SITEKEY \
    VITE_SNOW=$VITE_SNOW

RUN npm run build

FROM nginx:1.27-alpine

# The official Nginx image renders files in /etc/nginx/templates at startup.
# This keeps the non-public Django admin path configurable through the shared
# production env file without expanding Nginx runtime variables such as $host.
COPY nginx/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
