$visitorId = "curl-test-visitor-" + [guid]::NewGuid().ToString()
$sessionId = "curl-test-session-" + [guid]::NewGuid().ToString()

$body = @{
  event_type = "page_view"
  path = "/?utm_source=test&utm_medium=manual&utm_campaign=curl_debug"
  source_type = "test"
  utm_source = "test"
  utm_medium = "manual"
  utm_campaign = "curl_debug"
  anonymous_id = $visitorId
  session_id = $sessionId
  device_type = "desktop"
  browser = "curl"
  os = "Windows"
  language = "ru-RU"
}


$utf8NoBom = New-Object System.Text.UTF8Encoding($false)
[System.IO.File]::WriteAllText((Resolve-Path ".").Path + "\analytics-test.json", $body, $utf8NoBom)| ConvertTo-Json -Compress